# Gmailnator (Emailnator) API
# Hämta din API-nyckel från: https://rapidapi.com/Privatix/api/gmailnator
RAPIDAPI_KEY=your_rapidapi_key_here

# Oxylabs Residential Proxy API
# Dokumentation: docs/oxlabs dokumentasjon.md
OXYLABS_USERNAME=your_oxylabs_username
OXYLABS_PASSWORD=your_oxylabs_password

# 2Captcha API
# För att lösa CAPTCHA utmaningar
CAPTCHA_API_KEY=your_2captcha_api_key
